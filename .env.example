# These settings are for local development only. The development identity is
# accepted only with DEBUG=True and a loopback client address.
DEBUG=true
ENABLE_DEV_ANONYMOUS_USER=true

# Public frontend URL used after Google sign-in.
FRONTEND_URL=http://localhost:3000

# Create OAuth credentials in Google Cloud Console. Set the authorized redirect
# URI to http://localhost:8000/accounts/google/login/callback/ locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification uses the console in DEBUG mode. Configure SMTP for
# production so signup confirmation messages can be delivered.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@meetula.com

# Configure all five values to enable R2 uploads. In DEBUG mode, leaving them
# all empty uses local storage. Use the S3 API endpoint and a public bucket
# domain (custom domain or the bucket's public r2.dev URL).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# Used only to display images already stored in Cloudinary.
CLOUD_NAME=
