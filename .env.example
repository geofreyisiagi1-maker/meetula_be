# These settings are for local development only. The development identity is
# accepted only with DEBUG=True and a loopback client address.
DEBUG=true
ENABLE_DEV_ANONYMOUS_USER=true

# Configure these Cloudinary values to enable community image uploads.
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret
